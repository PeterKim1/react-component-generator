{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-test.ts\"",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.*.local)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(**/.aws/**)",
      "Edit(**/.ssh/**)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(* .env.local*)",
      "Bash(* .env.development*)",
      "Bash(* .env.production*)",
      "Bash(* .env.test*)",
      "Bash(* *.pem*)",
      "Bash(* *.key*)",
      "Bash(* *credential*)",
      "Bash(* *secret*)",
      "Bash(* *id_rsa*)",
      "Bash(* *id_ed25519*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env *)"
    ]
  }
}
